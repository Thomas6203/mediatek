\section{Method}

\subsection{Problem Formulation}

Let $\mathcal U$ be users and $\mathcal I$ the catalog, with $N=|\mathcal I|$. User interactions are ordered:
\begin{equation}
  \mathcal H_u=(i_1,i_2,\ldots,i_{T_u}).
\end{equation}
At transition $t$, the state is prefix $s_t=(i_1,\ldots,i_t)$ and logged next item $i_{t+1}$ is positive. The policies are
\begin{equation}
  \pi_L(a\mid s_L),\qquad
  \pi_S(a\mid s_S),\qquad
  \pi_C(a\mid s_L,s_S).
\end{equation}

\subsection{Pipeline Overview}

